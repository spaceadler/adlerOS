# adlerOS's settings. ./install.sh makes .env from this, asking for the ones
# that matter; after editing .env, run `docker compose up -d` here.

# The password for adlerOS. Changing it here (then `docker compose up -d`)
# logs out every browser; or change it in Settings.
OS_PASSWORD=__PASS__
# Signs login sessions.
OS_SESSION_SECRET=__HEX64__
# Your first name, for the greeting. Optional.
OS_NAME=
# The port adlerOS answers on: http://<this machine>:8686
ADLEROS_PORT=8686
# How your browser reaches this machine (an IP address or a name). Apps
# adlerOS finds or installs get http://<this>:<their port>.
ADLEROS_HOST=
# Where your docker compose files are, separated by ":", e.g.
# /home/you/docker:/opt/stacks. adlerOS looks three folders deep below each.
COMPOSE_ROOTS=
# Where apps from adlerOS's store go. Empty: ./apps
APPS_DIR=
# Your files: what the Files window shows (read-write), and where store apps
# look for music, books and downloads. install.sh asks; ~/storage if blank.
STORAGE_DIR=
# Files' Desktop (desktop mode shows it on the desktop), read-write.
# install.sh asks; STORAGE_DIR/Desktop if blank.
DESKTOP_DIR=
# A folder Files shows as Root, read-only (your homelab's folder, say). Blank:
# none. Changing things in it needs admin mode and ADLEROS_TERMINAL=on.
FILES_ROOT=
# Your wallpapers: a folder in STORAGE_DIR (Settings → Wallpaper lists them).
# Empty: Other/Wallpapers.
WALLPAPER_DIR=
# adlerMD's first vault: a folder of notes in STORAGE_DIR (an Obsidian vault
# works). Empty: none; adlerMD asks you to make one or open one.
NOTES_DIR=
# A shell on this machine in adlerOS's Terminal window: on or off. Even when
# on, it's only there in admin mode (which your password turns on).
ADLEROS_TERMINAL=off
# Where a new terminal starts, e.g. ~/homelab. Empty: your home folder. The
# shell is your login shell (`chsh` changes it).
ADLEROS_TERMINAL_DIR=
# Who adlerOS answers: tailscale (only your tailnet's devices), anyone (anyone
# who can reach this machine: your Wi-Fi too), or addresses and networks,
# comma-separated (e.g. tailscale,192.168.1.20). Everyone else gets no answer
# at all. install.sh asks: tailscale if this machine is on a tailnet.
ADLEROS_NETWORKS=
# Behind a reverse proxy (for HTTPS, at a name like os.example.com): its
# address or network, comma-separated, so adlerOS believes what it says about
# who's visiting and over what (e.g. 172.16.7.0/24, its Docker network). Empty:
# none.
ADLEROS_TRUSTED_PROXIES=
# Timezone, e.g. Europe/Amsterdam.
TZ=
# Who adlerOS runs as: your user and group IDs (`id -u`, `id -g`).
PUID=
PGID=
