# adlerOS's settings. ./install.sh makes .env from this, asking for the ones
# that matter; after editing .env, run `docker compose up -d` here.

# The password for adlerOS. Changing it here (then `docker compose up -d`)
# logs out every browser; or change it in Settings.
OS_PASSWORD=__PASS__
# Signs login sessions.
OS_SESSION_SECRET=__HEX64__
# Your first name, for the greeting. Optional.
OS_NAME=
# The port adlerOS answers on: http://<this machine>:8686
ADLEROS_PORT=8686
# How your browser reaches this machine (an IP address or a name). Apps
# adlerOS finds or installs get http://<this>:<their port>.
ADLEROS_HOST=
# Where your docker compose files are, separated by ":", e.g.
# /home/you/docker:/opt/stacks. adlerOS looks three folders deep below each.
COMPOSE_ROOTS=
# Where apps from adlerOS's store go. Empty: ./apps
APPS_DIR=
# Your files: what the Files window shows (read-write), and where store apps
# look for music, books and downloads. install.sh asks; ~/storage if blank.
STORAGE_DIR=
# A shell on this machine in adlerOS's Terminal window: on or off. Even when
# on, it opens only in admin mode and asks for your password each time.
ADLEROS_TERMINAL=off
# Timezone, e.g. Europe/Amsterdam.
TZ=
# Who adlerOS runs as: your user and group IDs (`id -u`, `id -g`).
PUID=
PGID=
