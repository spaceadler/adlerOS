# Rendered by install.sh into /etc/systemd/system/adleros-agent.service.
# Started by adleros-agent.path whenever adlerOS queues a request.
[Unit]
Description=adlerOS helper: runs what adlerOS asks for
After=docker.service network-online.target
Wants=network-online.target
# agent.py waits 5 s for more requests before it exits, so a run is never
# shorter: 30 starts in a minute means it crashes as it starts. (systemd's
# default, 5 in 10 s, was reached by a few quick clicks, and then the .path
# stopped starting it at all.)
StartLimitIntervalSec=60
StartLimitBurst=30

[Service]
Type=oneshot
User=${AGENT_USER}
Group=${AGENT_GROUP}
WorkingDirectory=${ADLEROS_DIR}
ExecStart=/usr/bin/python3 -I ${ADLEROS_DIR}/agent/agent.py
# Installing a big app from the store can take a while on a first run.
TimeoutStartSec=4h
PrivateTmp=yes
