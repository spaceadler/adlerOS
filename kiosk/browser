#!/usr/bin/env bash
# Inside labwc: Chromium on adlerOS, full screen, again whenever it closes;
# done when labwc is.
#
#   kiosk/browser URL
#
# Extra Chromium flags, one per line, from ~/.config/adleros-kiosk/flags
# (say --remote-debugging-port=9223 while measuring; 127.0.0.1 only).
set -u
url=${1:?usage: kiosk/browser URL}
profile=${XDG_DATA_HOME:-$HOME/.local/share}/adleros-kiosk
extra=${XDG_CONFIG_HOME:-$HOME/.config}/adleros-kiosk/flags
mkdir -p "$profile"
chromium=$(command -v chromium || command -v chromium-browser)

# Done when labwc is (its socket gone).
while [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-none}" ]; do
    # adlerOS answering first (at boot it may be a moment behind).
    for _ in $(seq 60); do
        curl -fsS -m 2 -o /dev/null "${url%/}/healthz" && break
        sleep 2
    done
    # Closed by a crash or the power going: no "restore pages?" bar.
    prefs=$profile/Default/Preferences
    [ -f "$prefs" ] && sed -i 's/"exited_cleanly":false/"exited_cleanly":true/; s/"exit_type":"[^"]*"/"exit_type":"Normal"/' "$prefs"
    flags=()
    [ -r "$extra" ] && mapfile -t flags < <(grep -E '^--' "$extra")
    "$chromium" --kiosk --ozone-platform=wayland --user-data-dir="$profile" \
        --noerrdialogs --disable-infobars --no-first-run --no-default-browser-check \
        --disable-session-crashed-bubble --disable-features=Translate,TranslateUI \
        --password-store=basic --check-for-update-interval=31536000 \
        --autoplay-policy=no-user-gesture-required --overscroll-history-navigation=0 \
        "${flags[@]}" "$url"
    sleep 2
done
