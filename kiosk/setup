#!/usr/bin/env bash
# Turns adlerOS's kiosk on or off for the screen's console (tty1): when you
# log in there (automatically, if the console logs you in by itself),
# adlerOS starts full screen instead of the shell.
#
#   kiosk/setup on URL [chromium|wpe]   (e.g. https://os.example.com wpe)
#   kiosk/setup off
#
# chromium (the default): Chromium inside labwc. wpe: WPE WebKit (cog) drawn
# straight to the screen, no window system; lighter, an older engine.
#
# On needs nothing installed beyond labwc and Chromium, and no sudo: it adds
# a few lines to your shell's login (fish's conf.d, else ~/.profile). Off
# takes them out; a kiosk that's running stops at the next log-in.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
mark="# adlerOS kiosk (kiosk/setup)"
fishfile=${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/adleros-kiosk.fish
profile=$HOME/.profile

case "${1:-}" in
on)
    url=${2:?usage: kiosk/setup on URL [chromium|wpe]}
    engine=${3:-chromium}
    case "$engine" in chromium | wpe) ;; *) echo "engine: chromium or wpe" >&2; exit 2 ;; esac
    case "$url" in http://* | https://*) ;; *) echo "URL: http://… or https://…" >&2; exit 2 ;; esac
    command -v curl >/dev/null || { echo "needs curl" >&2; exit 1; }
    if [ "$engine" = wpe ]; then
        command -v cog >/dev/null || { echo "needs cog (sudo apt install cog)" >&2; exit 1; }
    else
        command -v labwc >/dev/null || { echo "needs labwc" >&2; exit 1; }
        command -v chromium >/dev/null || command -v chromium-browser >/dev/null || { echo "needs chromium" >&2; exit 1; }
    fi
    q=$(printf '%q' "$url")
    if [ "$(basename "${SHELL:-}")" = fish ] || [ -d "$(dirname "$fishfile")" ]; then
        mkdir -p "$(dirname "$fishfile")"
        cat >"$fishfile" <<EOF
$mark
if status is-login; and test (tty) = /dev/tty1; and not set -q WAYLAND_DISPLAY
    "$here/start" $q $engine
end
EOF
        echo "on: $fishfile"
    fi
    if [ "$(basename "${SHELL:-}")" != fish ]; then
        tmp=$(mktemp)
        grep -vF "$mark" "$profile" 2>/dev/null >"$tmp" || true
        echo "[ \"\$(tty)\" = /dev/tty1 ] && [ -z \"\${WAYLAND_DISPLAY:-}\" ] && \"$here/start\" $q $engine $mark" >>"$tmp"
        mv "$tmp" "$profile"
        echo "on: $profile"
    fi
    echo "It starts ($engine) the next time the console (tty1) logs in."
    ;;
off)
    rm -f "$fishfile"
    if [ -f "$profile" ] && grep -qF "$mark" "$profile"; then
        tmp=$(mktemp)
        grep -vF "$mark" "$profile" >"$tmp" || true
        mv "$tmp" "$profile"
    fi
    echo "off: the console stays a console from its next log-in."
    ;;
*)
    echo "usage: kiosk/setup on URL | off" >&2
    exit 2
    ;;
esac
