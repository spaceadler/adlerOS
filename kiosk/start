#!/usr/bin/env bash
# adlerOS on the screen, full screen, no browser around it: labwc (a small
# Wayland compositor) with one of two engines, Chromium in kiosk mode
# (kiosk/browser) or WPE WebKit through cog (kiosk/wpe). Run from the
# console's login (kiosk/setup on puts the hook there), not over SSH.
#
#   kiosk/start URL [chromium|wpe]
#
# The engine comes back by itself if it closes or crashes; labwc does too, unless it keeps failing at once: three quick failures in
# a row and this gives up and leaves you at the console.
set -u
here=$(cd "$(dirname "$0")" && pwd)
url=${1:?usage: kiosk/start URL [chromium|wpe]}
engine=${2:-chromium}
state=${XDG_STATE_HOME:-$HOME/.local/state}/adleros-kiosk
mkdir -p "$state"
log=$state/kiosk.log
[ -f "$log" ] && [ "$(stat -c %s "$log")" -gt 1048576 ] && mv -f "$log" "$log.old"

# The keyboard the console has.
if [ -r /etc/default/keyboard ]; then
    # shellcheck disable=SC1091
    . /etc/default/keyboard
    export XKB_DEFAULT_MODEL=${XKBMODEL:-} XKB_DEFAULT_LAYOUT=${XKBLAYOUT:-} XKB_DEFAULT_VARIANT=${XKBVARIANT:-} XKB_DEFAULT_OPTIONS=${XKBOPTIONS:-}
fi

case "$engine" in
wpe) runner=$here/wpe ;;
*) runner=$here/browser ;;
esac

fails=0
while :; do
    began=$(date +%s)
    echo "$(date '+%F %T') starting labwc ($engine) for $url" >>"$log"
    labwc -C "$here/labwc" -s "$runner $url" >>"$log" 2>&1
    echo "$(date '+%F %T') labwc ended ($?)" >>"$log"
    if [ $(( $(date +%s) - began )) -lt 15 ]; then
        fails=$((fails + 1))
        if [ "$fails" -ge 3 ]; then
            echo "adlerOS kiosk: it failed $fails times in a row; see $log. Leaving you at the console."
            exit 1
        fi
        sleep 3
    else
        fails=0
    fi
done
