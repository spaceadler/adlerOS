#!/usr/bin/env bash
# Inside labwc: adlerOS through WPE WebKit (cog), full screen, again
# whenever it closes; done when labwc is.
#
#   kiosk/wpe URL
#
# (cog can draw straight to the screen, but Debian 12's cog 0.16 crashes
# setting up the mouse pointer there on a Pi; inside labwc the pointer is
# labwc's.) Extra cog options, one per line, from
# ~/.config/adleros-kiosk/wpe-flags.
set -u
url=${1:?usage: kiosk/wpe URL}
data=${XDG_DATA_HOME:-$HOME/.local/share}/adleros-kiosk-wpe
extra=${XDG_CONFIG_HOME:-$HOME/.config}/adleros-kiosk/wpe-flags
mkdir -p "$data"
export COG_PLATFORM_WL_VIEW_FULLSCREEN=1

while [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY:-none}" ]; do
    for _ in $(seq 60); do
        curl -fsS -m 2 -o /dev/null "${url%/}/healthz" && break
        sleep 2
    done
    flags=()
    [ -r "$extra" ] && mapfile -t flags < <(grep -E '^-' "$extra")
    cog -P wl --bg-color=black --webprocess-failure=restart \
        --cookie-store=always --cookie-jar="sqlite:$data/cookies.sqlite" \
        --enable-media=true --enable-webaudio=true --enable-fullscreen=true \
        --enable-accelerated-2d-canvas=true --enable-html5-local-storage=true \
        --enable-html5-database=true --enable-developer-extras=false \
        "${flags[@]}" "$url"
    sleep 2
done
